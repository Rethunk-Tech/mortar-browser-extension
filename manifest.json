{
  "manifest_version": 3,
  "name": "Mortar",
  "version": "0.1.1",
  "description": "Sends Nexus Mods Mod Manager Download links to the Mortar mod manager, so a burst of downloads from many tabs all arrive.",
  "key": "",
  "permissions": ["alarms", "nativeMessaging", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["plural.js", "updates.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://www.nexusmods.com/*"],
      "js": [
        "plural.js",
        "fileLabels.js",
        "modPanel.js",
        "collectionCount.js",
        "menu.js",
        "menuRequirements.js",
        "hideInProfile.js",
        "listingMarks.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "mortar@rethunk.tech",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "host_permissions": ["https://www.nexusmods.com/*"]
}
