{
  "manifest_version": 3,
  "name": "Mortar",
  "version": "0.2.3",
  "description": "Sends Nexus Mods Mod Manager Download clicks to the Mortar desktop mod manager and marks mods you already have.",
  "key": "",
  "permissions": ["alarms", "nativeMessaging", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["plural.js", "updates.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://www.nexusmods.com/*"],
      "js": [
        "plural.js",
        "fileLabels.js",
        "modPanel.js",
        "collectionCount.js",
        "menu.js",
        "menuRequirements.js",
        "hideInProfile.js",
        "listingMarks.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "mortar@rethunk.tech",
      "update_url": "https://github.com/Rethunk-Tech/mortar-browser-extension/releases/latest/download/updates.json",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "host_permissions": ["https://www.nexusmods.com/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
