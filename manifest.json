{
  "manifest_version": 3,
  "name": "Mortar",
  "version": "0.0.1",
  "description": "Sends Nexus Mods Mod Manager Download links to the Mortar mod manager, so a burst of downloads from many tabs all arrive.",
  "key": "",
  "permissions": ["nativeMessaging", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://www.nexusmods.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "mortar@rethunk.tech",
      "strict_min_version": "128.0"
    }
  },
  "host_permissions": ["https://www.nexusmods.com/*"]
}
